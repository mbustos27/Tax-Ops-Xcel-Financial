*switch: MediaType
{
	*case: Plain
	{
		*DraftQualitySettings: LIST(Resolution.Option1)
		*BetterQualitySettings: LIST(Resolution.Option2)
		*BestQualitySettings: LIST(Resolution.Option3)
		*DefaultQuality: BETTERQUALITY
	}
	*case: Inkjet
	{
		*DraftQualitySettings: LIST()
		*BetterQualitySettings: LIST(Resolution.Option3)
		*BestQualitySettings: LIST(Resolution.Option4)
		*DefaultQuality: BETTERQUALITY
	}
	*case: Glossy
	{
		*DraftQualitySettings: LIST()
		*BetterQualitySettings: LIST(Resolution.Option3)
		*BestQualitySettings: LIST(Resolution.Option4)
		*DefaultQuality: BESTQUALITY
	}
	*case: Glossy_tri
	{
		*DraftQualitySettings: LIST()
		*BetterQualitySettings: LIST(Resolution.Option3)
		*BestQualitySettings: LIST(Resolution.Option4)
		*DefaultQuality: BESTQUALITY
	}
	*default:
	{
		*DraftQualitySettings: LIST()
		*BetterQualitySettings: LIST(Resolution.Option3)
		*BestQualitySettings: LIST(Resolution.Option4)
		*DefaultQuality: BETTERQUALITY
	}
}


*Feature: Orientation
{
    *rcNameID: =ORIENTATION_DISPLAY
    *DefaultOption: PORTRAIT
    *Option: PORTRAIT
    {
        *rcNameID: =PORTRAIT_DISPLAY
    }
    *Option: LANDSCAPE_CC270
    {
        *rcNameID: =LANDSCAPE_DISPLAY
    }
}

*Feature: InkjetQuality
{
    *rcNameID: =BRID_QUALITY_INKJETMODE_DISPLAY
