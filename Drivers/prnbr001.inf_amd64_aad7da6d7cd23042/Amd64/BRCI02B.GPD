*Feature: ColorMode
{
	*rcNameID: =COLOR_PRINTING_MODE_DISPLAY
	*DefaultOption: Color
	*Option: Mono
	{
		*rcNameID: =BRID_COLORMODE_GRAYSCALE_DISPLAY
		*DevNumOfPlanes: 0
		*DevBPP: 0
		*DrvBPP: 24
		*Color?: FALSE
		*IPCallbackID: 2
	}
	*Option: Color
	{
		*rcNameID: =BRID_COLORMODE_COLOR_DISPLAY
		*DevNumOfPlanes: 0
		*DevBPP: 0
		*DrvBPP: 24
		*Color?: TRUE
		*IPCallbackID: 1
	}
}

