*GPDSpecVersion: "1.0"
*GPDFileName: "BRM8820U.GPD"
*GPDFileVersion: "1.0"
*Include: "brhbp03.gpd"
*ModelName: "Brother MFC-8820D USB"
*PrintRate: 16
*PrintRatePPM: 16
*PrintRateUnit: PPM

*Feature: Resolution
{
    *rcNameID: =RESOLUTION_DISPLAY
    *DefaultOption: Option2
    *Option: Option1
    {
        *Name: "HQ 1200"
        *DPI: PAIR(1200, 1200)
        *TextDPI: PAIR(1200, 1200)
        *PinsPerLogPass: 32
        *PinsPerPhysPass: 1
        *SpotDiameter: 100
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *Cmd: "@L<0F>"
        }
    }
    *Option: Option2
    {
        *Name: "600 x 600 " =DOTS_PER_INCH
        *DPI: PAIR(600, 600)
        *TextDPI: PAIR(600, 600)
        *PinsPerLogPass: 32
        *PinsPerPhysPass: 1
        *SpotDiameter: 100
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *Cmd: "@L<00>"
        }
    }
    *Option: Option3
    {
        *Name: "300 x 300 " =DOTS_PER_INCH
        *DPI: PAIR(300, 300)
        *TextDPI: PAIR(300, 300)
        *PinsPerLogPass: 32
        *PinsPerPhysPass: 1
        *SpotDiameter: 100
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *Cmd: "@L<05>"
        }
    }
}

*Feature: PrintArea
{
    *rcNameID: 352
    *FeatureType: PRINTER_PROPERTY
    *DefaultOption: Normal
    *Option: Normal
    {
        *rcNameID: =OFF_DISPLAY
    }
    *Option: Wide
    {
        *rcNameID: =ON_DISPLAY
    }
}
*Feature: InputBin
{
    *rcNameID: =PAPER_SOURCE_DISPLAY
    *DefaultOption: AUTO
    *Option: AUTO
    {
        *rcNameID: 320
*%        *Constraints: LIST (PaperSize.ENV_10, PaperSize.ENV_DL,PaperSize.ENV_C5,PaperSize.ENV_MONARCH)
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *Cmd: "@S<6F>"
        }
    }
    *Option: UPPER
    {
        *rcNameID: 321
        *Constraints: LIST (PaperSize.ENV_10, PaperSize.ENV_DL,PaperSize.ENV_C5,PaperSize.ENV_MONARCH)
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *Cmd: "@S<31>"
        }
    }
    *Option: LOWER
    {
        *rcNameID: 322
        *Constraints: LIST (PaperSize.A6,PaperSize.ENV_10, PaperSize.ENV_DL,PaperSize.ENV_C5,PaperSize.ENV_MONARCH,PaperSize.JAPANESE_POSTCARD)
        *Installable?: TRUE
        *rcInstallableFeatureNameID: 322
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *Cmd: "@S<32>"
        }
    }
    *Option: MP
    {
        *rcNameID: 326
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *Cmd: "@S<4F>"
        }
    }
    *Option: MANUAL
    {
        *rcNameID: 325
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *Cmd: "@S<4D>"
        }
    }
}

*Feature: SecurePrint
{
    *Name: "SecurePrint"
    *DefaultOption: Off

    *Option: Off
    {
        *Name: "Off"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.1
            *CallbackID: 11
        }
    }
}

*Feature: PaperWidth
{
    *Name: "PaperWidth"
    *DefaultOption: Off
    *Option: Off
    {
        *Name: "Off"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.5
            *CallbackID: 12
        }
    }
}

*Feature: Duplex
{
    *rcNameID: =TWO_SIDED_PRINTING_DISPLAY
    *DefaultOption: NONE
    *Option: NONE
    {
        *rcNameID: =NONE_DISPLAY
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.6
            *Cmd: "@O<30>"
        }
    }
    *Option: VERTICAL
    {
        *rcNameID: =FLIP_ON_LONG_EDGE_DISPLAY
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.6
            *Cmd: "@O<32>"
        }
*%        *Constraints: LIST(MediaType.TRANSPARENCY)
        *Constraints: LIST(Resolution.Option1,PaperSize.EXECUTIVE,PaperSize. B5,PaperSize. A5,PaperSize. A6,PaperSize.ENV_B5,PaperSize.ENV_10,PaperSize.ENV_DL,PaperSize.ENV_C5,PaperSize.ENV_MONARCH,PaperSize.JAPANESE_POSTCARD,PaperSize.CUSTOMSIZE)
    }
    *Option: HORIZONTAL
    {
        *rcNameID: =FLIP_ON_SHORT_EDGE_DISPLAY
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.6
            *Cmd: "@O<31>"
        }
*%        *Constraints: LIST(MediaType.TRANSPARENCY)
        *Constraints: LIST(Resolution.Option1,PaperSize.EXECUTIVE,PaperSize. B5,PaperSize. A5,PaperSize. A6,PaperSize.ENV_B5,PaperSize.ENV_10,PaperSize.ENV_DL,PaperSize.ENV_C5,PaperSize.ENV_MONARCH,PaperSize.JAPANESE_POSTCARD,PaperSize.CUSTOMSIZE)
    }
}

