{
    *rcNameID: =MEDIA_TYPE_DISPLAY
    *DefaultOption: STANDARD
    *Option: STANDARD
    {
        *rcNameID: 300
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.7
