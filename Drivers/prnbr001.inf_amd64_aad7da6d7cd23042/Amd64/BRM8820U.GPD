*Feature: PaperCmd
{
    *Name: "Paper"
    *DefaultOption: Option1
    *Option: Option1
    {
        *Name: ""
        *switch: PaperSize
        {
            *case: LETTER
            {
                *Command: CmdSelect
                {
                    *Order: DOC_SETUP.9
                    *Cmd: "@W<0200>"
                }
            }
            *case: A4
            {
                *Command: CmdSelect
                {
                    *Order: DOC_SETUP.9
                    *Cmd: "@W<1A00>"
                }
            }
            *case: LEGAL
            {
                *Command: CmdSelect
                {
                    *Order: DOC_SETUP.9
                    *Cmd: "@W<0300>"
                }
            }
            *case: EXECUTIVE
            {
                *Command: CmdSelect
                {
                    *Order: DOC_SETUP.9
                    *Cmd: "@W<0100>"
                }
            }
            *case: FOLIO
            {
                *Command: CmdSelect
                {
                    *Order: DOC_SETUP.9
                    *Cmd: "@W<0E04>"
                }
            }
            *case: B5
            {
                *Command: CmdSelect
                {
                    *Order: DOC_SETUP.9
                    *Cmd: "@W<2D00>"
                }
            }
            *case: A5
            {
                *Command: CmdSelect
                {
                    *Order: DOC_SETUP.9
                    *Cmd: "@W<1900>"
                }
            }
            *case: A6
            {
                *Command: CmdSelect
                {
                    *Order: DOC_SETUP.9
                    *Cmd: "@W<1800>"
                }
            }
            *case: ENV_B5
            {
                *Command: CmdSelect
                {
                    *Order: DOC_SETUP.9
                    *Cmd: "@W<6400>"
                }
            }
            *case: ENV_10
            {
                *Command: CmdSelect
                {
                    *Order: DOC_SETUP.9
                    *Cmd: "@W<5100>"
                }
            }
            *case: ENV_DL
            {
                *Command: CmdSelect
                {
                    *Order: DOC_SETUP.9
                    *Cmd: "@W<5A00>"
                }
            }
            *case: ENV_C5
            {
                *Command: CmdSelect
                {
                    *Order: DOC_SETUP.9
                    *Cmd: "@W<5B00>"
                }
            }
            *case: ENV_MONARCH
            {
                *Command: CmdSelect
                {
                    *Order: DOC_SETUP.9
                    *Cmd: "@W<5000>"
                }
            }
            *case: JAPANESE_POSTCARD
            {
                *Command: CmdSelect
                {
                    *Order: DOC_SETUP.9
                    *Cmd: "@W<4700>"
                }
            }
            *default:
            {
                *Command: CmdSelect
                {
                    *Order: DOC_SETUP.9
                    *Cmd: "@W<6500>"
                }
            }
        }
    }
}

*Feature: Memory
{
    *rcNameID: =PRINTER_MEMORY_DISPLAY
    *DefaultOption: 32768KB
    *Option: 32768KB
    {
        *Name: "32MB"
        *MemoryConfigKB: PAIR(32768, 16384)
    }
}
