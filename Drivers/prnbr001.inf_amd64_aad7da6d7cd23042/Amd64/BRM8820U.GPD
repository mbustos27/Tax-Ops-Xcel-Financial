        *rcNameID: 301
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.7
            *Cmd: "@J<0004>"
        }
    }
    *Option: Thick
    {
        *rcNameID: 302
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.7
            *Cmd: "@J<0001>"
        }
    }
    *Option: Thicker
    {
        *rcNameID: 303
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.7
            *Cmd: "@J<0002>"
        }
    }
    *Option: Bond
    {
        *rcNameID: 304
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.7
            *Cmd: "@J<0005>"
        }
    }
    *Option: TRANSPARENCY
    {
        *rcNameID: 305
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.7
            *Cmd: "@J<0003>"
        }
    }
    *Option: Enverope
    {
        *rcNameID: 306
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.7
            *Cmd: "@J<0006>"
        }
    }
    *Option: Env_Thick
    {
        *rcNameID: 307
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.7
            *Cmd: "@J<0007>"
