*GPDSpecVersion: "1.0"
*GPDFileVersion: "1.0"
*GPDFileName: "BRPT9500.GPD"
*Include: "StdNames.gpd"
*ModelName: "Brother PT-9500PC"
*MasterUnits: PAIR(360, 360)
*ResourceDLL: "brptui.dll"
*PrinterType: SERIAL
*MemoryUsage: LIST(RASTER)
*RotateCoordinate?: FALSE
*RotateRaster?: FALSE
*RotateFont?: FALSE
*Feature: Resolution
{
    *rcNameID: =RESOLUTION_DISPLAY
    *DefaultOption: Option1
    *Option: Option1
    {
        *Name: "360 x 360 " =DOTS_PER_INCH
        *DPI: PAIR(360, 360)
        *TextDPI: PAIR(360, 360)
        *SpotDiameter: 100
        *Command: CmdSendBlockData { *Cmd : "" }
    }
}
*Feature: Orientation
{
    *rcNameID: =ORIENTATION_DISPLAY
    *DefaultOption: LANDSCAPE_CC270
    *Option: PORTRAIT
    {
        *rcNameID: =PORTRAIT_DISPLAY
    }
    *Option: LANDSCAPE_CC270
    {
        *rcNameID: =LANDSCAPE_DISPLAY
    }
}
*Feature: InputBin
{
    *rcNameID: =PAPER_SOURCE_DISPLAY
    *DefaultOption: TAPE
    *Option: TAPE
    {
        *rcNameID: 301	*% Cassette
    }
}
*Include: "BRPT.gpd"
*Command: CmdStartPage
{
	*Order: PAGE_SETUP.1
	*CallbackID: 5
	*Params: LIST(PhysPaperWidth, PhysPaperLength, PageNumber)
}
*Command: CmdStartJob
{
    *Order: JOB_SETUP.1
    *Cmd: "<1B>@"
}
*Command: CmdEndDoc
{
    *Order: DOC_FINISH.1
    *Cmd: "<1A>"
}
*Command: CmdCR { *Cmd : "" }
*Command: CmdLF { *Cmd : "" }
*Command: CmdFF { *Cmd : "" }
