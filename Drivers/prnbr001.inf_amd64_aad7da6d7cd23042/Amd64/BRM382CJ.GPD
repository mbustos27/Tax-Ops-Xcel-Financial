*Feature: MediaType
{
    *rcNameID: =MEDIA_TYPE_DISPLAY
	*UpdateQualityMacro?: TRUE
    *DefaultOption: Plain
    *Option: Plain
    {
        *rcNameID: =BRID_MEDIATYPE_PLAIN_DISPLAY
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *CallbackID: 20
        }
    }
    *Option: Inkjet
    {
        *rcNameID: =BRID_MEDIATYPE_INKJET_DISPLAY
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *CallbackID: 21
        }
		*Constraints: LIST( Resolution.Option1, Resolution.Option2 )
    }
    *Option: Glossy
    {
        *rcNameID: =BRID_MEDIATYPE_GLOSSY4_DISPLAY
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *CallbackID: 22
        }
		*Constraints: LIST( Resolution.Option1, Resolution.Option2 )
    }
    *Option: Glossy_tri
    {
        *rcNameID: =BRID_MEDIATYPE_GLOSSY3_DISPLAY
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *CallbackID: 26
        }
		*Constraints: LIST( Resolution.Option1, Resolution.Option2 )
    }
    *Option: Transparency
    {
        *rcNameID: =BRID_MEDIATYPE_OHP_DISPLAY
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *CallbackID: 24
        }
		*Constraints: LIST( Resolution.Option1, Resolution.Option2 )
    }
}

