*GPDSpecVersion: "1.0"
*GPDFileName: "BRF4750U.GPD"
*GPDFileVersion: "1.0"
*ModelName: "Brother FAX-4750e USB"
*MasterUnits: PAIR(600, 600)
*ResourceDLL: "brother.dll"
*PrinterType: PAGE
*Include: "StdNames.gpd"
*PrintRate: 14
*PrintRatePPM: 14
*PrintRateUnit: PPM
*rcInstalledOptionNameID: =ON_DISPLAY
*rcNotInstalledOptionNameID: =OFF_DISPLAY

*Feature: Orientation
{
    *rcNameID: =ORIENTATION_DISPLAY
    *DefaultOption: PORTRAIT
    *Option: PORTRAIT
    {
        *rcNameID: =PORTRAIT_DISPLAY
    }
    *Option: LANDSCAPE_CC270
    {
        *rcNameID: =LANDSCAPE_DISPLAY
    }
}
*Feature: Resolution
{
    *rcNameID: =RESOLUTION_DISPLAY
    *DefaultOption: Option1
    *Option: Option1
    {
        *Name: "600 x 600 " =DOTS_PER_INCH
        *DPI: PAIR(600, 600)
        *TextDPI: PAIR(600, 600)
        *PinsPerLogPass: 32
        *PinsPerPhysPass: 1
        *SpotDiameter: 100
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *Cmd: "@L<00>"
        }
    }
    *Option: Option2
    {
        *Name: "300 x 300 " =DOTS_PER_INCH
        *DPI: PAIR(300, 300)
        *TextDPI: PAIR(300, 300)
        *PinsPerLogPass: 32
        *PinsPerPhysPass: 1
        *SpotDiameter: 100
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *Cmd: "@L<05>"
        }
    }
}
*Feature: InputBin
{
    *rcNameID: =PAPER_SOURCE_DISPLAY
    *DefaultOption: AUTO
    *Option: AUTO
    {
        *rcNameID: =AUTO_DISPLAY
        *Constraints: LIST (PaperSize.ENV_10, PaperSize.ENV_DL,PaperSize.ENV_C5,PaperSize.ENV_MONARCH)
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *Cmd: "@S<30>"
        }
    }
    *Option: UPPER
    {
        *rcNameID: =UPPER_TRAY_DISPLAY
        *Constraints: LIST (PaperSize.ENV_10, PaperSize.ENV_DL,PaperSize.ENV_C5,PaperSize.ENV_MONARCH)
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *Cmd: "@S<31>"
        }
    }
    *Option: LOWER
    {
        *rcNameID: =LOWER_TRAY_DISPLAY
        *Constraints: LIST (PaperSize.ENV_10, PaperSize.ENV_DL,PaperSize.ENV_C5,PaperSize.ENV_MONARCH)
        *Installable?: TRUE
        *rcInstallableFeatureNameID: =LOWER_TRAY_DISPLAY
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *Cmd: "@S<32>"
        }
    }
    *Option: MANUAL
    {
        *rcNameID: =MANUAL_FEED_DISPLAY
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *Cmd: "@S<4D>"
        }
    }
}
