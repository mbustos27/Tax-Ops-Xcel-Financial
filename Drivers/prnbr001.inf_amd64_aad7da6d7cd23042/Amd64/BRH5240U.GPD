*Feature: 1200Mode
{
	*Name: "1200dpi mode"
	*DefaultOption: HQ1200
	*Option:HQ1200
	{
		*Name: "HQ1200(2400x600 dpi)"
	}
	*Option:TRUE1200
	{
		*Name: "True1200(1200x1200 dpi)"
	}
}

*Feature: Resolution
{
    *rcNameID: 135
    *DefaultOption: Option2
	*Option: Option1
    {
        *rcNameID: 142
        *DPI: PAIR(1200, 1200)
        *TextDPI: PAIR(1200, 1200)
        *MinStripBlankPixels: 32
        *SpotDiameter: 100
		*switch: 1200Mode
		{
			*case: TRUE1200
			{
				*Command: CmdSelect
        		{
            		*Order: JOB_SETUP.20
            		*Cmd: "@PJL SET RESOLUTION=1200<0A>@PJL SET PAPERFEEDSPEED=HALF<0A>@PJL ENTER LANGUAGE=PCL<0A1B>E<1B>*t1200R"
        		}
			}
			*case: HQ1200
			{
				*Command: CmdSelect
        		{
            		*Order: JOB_SETUP.20
            		*Cmd: "@PJL SET RESOLUTION=1200<0A>@PJL SET PAPERFEEDSPEED=FULL<0A>@PJL ENTER LANGUAGE=PCL<0A1B>E<1B>*t1200R"
        		}
			}
		}
    }
    *Option: Option2
    {
        *rcNameID: 143
        *DPI: PAIR(600, 600)
        *TextDPI: PAIR(600, 600)
        *MinStripBlankPixels: 32
        *SpotDiameter: 100
        *Command: CmdSelect
        {
            *Order: JOB_SETUP.20
            *Cmd: "@PJL SET RESOLUTION=600<0A>@PJL ENTER LANGUAGE=PCL<0A1B>E<1B>*t600R"
        }
    }
    *Option: Option3
    {
        *rcNameID: 144
        *DPI: PAIR(300, 300)
        *TextDPI: PAIR(300, 300)
        *MinStripBlankPixels: 32
        *SpotDiameter: 100
        *Command: CmdSelect
        {
            *Order: JOB_SETUP.20
            *Cmd: "@PJL SET RESOLUTION=300<0A>@PJL ENTER LANGUAGE=PCL<0A1B>E<1B>*t300R"
        }
    }
}

