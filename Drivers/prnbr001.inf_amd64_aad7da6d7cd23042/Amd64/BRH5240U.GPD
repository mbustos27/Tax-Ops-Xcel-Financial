*Feature: BrPCLMediaType
{
	*Name: "PCLMediaType"
    *DefaultOption: 1
    *Option: 1
    {
       *Name: "1"
       *switch:MediaType
       {
          *case:STANDARD
          {
              *Command:CmdSelect
              {
                 *Order: DOC_SETUP.10
                 *Cmd: "<1B>&n8WdRegular"
              }
          }
          *case:Thin
          {
             *Command:CmdSelect
             {
                *Order: DOC_SETUP.10
                *Cmd: "<1B>&n5WdThin"
             }
          }
          *case:Thick
          {
             *Command:CmdSelect
             {
                *Order: DOC_SETUP.10
                *Cmd: "<1B>&n6WdThick"
             }
          }
          *case:Thicker
          {
             *Command:CmdSelect
             {
                *Order: DOC_SETUP.10
                *Cmd: "<1B>&n7WdThick2"
             }
          }
          *case:Bond
          {
             *Command:CmdSelect
             {
                *Order: DOC_SETUP.10
                *Cmd: "<1B>&n5WdBond"
             }
          }
          *case:TRANSPARENCY
          {
             *Command:CmdSelect
             {
                *Order: DOC_SETUP.10
                *Cmd: "<1B>&n10WdEnvelopes"
             }
          }
          *case:Envelopes
          {
             *Command:CmdSelect
             {
                *Order: DOC_SETUP.10
                *Cmd: "<1B>&n5WdBond"
             }
          }
          *case:Envthick
          {
	         *Command:CmdSelect
             {
                *Order: DOC_SETUP.10
                *Cmd: "<1B>&n9WdEnvthick"
             }
          }
          *case:Envthin
          {
             *Command:CmdSelect
    	     {
                *Order: DOC_SETUP.10
                *Cmd: "<1B>&n8WdEnvthin"
             }
          }
       }
    }
}

