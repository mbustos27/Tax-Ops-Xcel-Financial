*Feature: InputBin
{
    *rcNameID: =PAPER_SOURCE_DISPLAY
    *DefaultOption: AUTO
    *Option: AUTO
    {
        *rcNameID: =BRID_AUTOFEED_DISPLAY
    }
}


*Feature: MediaType
{
    *rcNameID: =MEDIA_TYPE_DISPLAY
	*UpdateQualityMacro?: TRUE
    *DefaultOption: Plain
    *Option: Plain
    {
        *rcNameID: =BRID_MEDIATYPE_PLAIN_DISPLAY
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *CallbackID: 20
        }
    }
    *Option: Inkjet
    {
        *rcNameID: =BRID_MEDIATYPE_INKJET_DISPLAY
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *CallbackID: 21
        }
		*Constraints: LIST( Resolution.Option1, Resolution.Option2 )
    }
    *Option: slowdry
    {
        *rcNameID: =BRID_MEDIATYPE_SLOWDRY_DISPLAY
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *CallbackID: 22
        }
    }
    *Option: Glossy_tri
    {
        *rcNameID: =BRID_MEDIATYPE_GLOSSY_DISPLAY
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *CallbackID: 26
        }
		*Constraints: LIST( Resolution.Option1, Resolution.Option2 )
		*switch: Resolution
		{
			*case: Option4
*%			*case: Plain
			{
			*Constraints: LIST( PaperSize.BR_A4_BL,PaperSize.BR_LETTER_BL,PaperSize.BR_A6_BL,PaperSize.BR_JP_POSTCARD_BL,PaperSize.BR_PHOTOL_BL,PaperSize.BR_PHOTO2L_BL ,PaperSize.BR_POSTCARSD_BL,PaperSize.BR_INDEXCARD_BL)
			}
		}
    }
    *Option: Transparency
    {
        *rcNameID: =BRID_MEDIATYPE_OHP_DISPLAY
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *CallbackID: 24
        }
		*Constraints: LIST( Resolution.Option1, Resolution.Option2 )
    }
}

