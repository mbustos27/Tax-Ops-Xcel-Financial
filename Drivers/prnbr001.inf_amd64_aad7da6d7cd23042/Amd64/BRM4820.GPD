    {
        *rcNameID: =RCID_DMPAPER_SYSTEM_NAME
        *switch: PrintArea
        {
            *case: EdgeNear
            {
                *PrintableArea: PAIR(2304, 4480)
                *PrintableOrigin: PAIR(11, 11)
                *CursorOrigin: PAIR(11, 11)
            }
            *default:
            {
                *PrintableArea: PAIR(2184, 3696)
                *PrintableOrigin: PAIR(70, 401)
                *CursorOrigin: PAIR(70, 401)
            }
        }
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.6
            *Cmd: ""
        }
    }

    *Option: BR_POST_CARD
    {
        *rcNameID: =BRID_PAPERSIZE_POSTCARD_DISPLAY
        *PageDimensions: PAIR(2400, 3600)
        *switch: PrintArea
        {
            *case: EdgeNear
            {
                *PrintableArea: PAIR(2376, 3576)
                *PrintableOrigin: PAIR(11, 11)
                *CursorOrigin: PAIR(11, 11)
            }
            *default:
            {
                *PrintableArea: PAIR(2256, 3456)
                *PrintableOrigin: PAIR(70, 70)
                *CursorOrigin: PAIR(70, 70)
            }
        }
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.6
            *CallbackID: 265
        }
    }
    *Option: BR_INDEX_CARD
    {
        *rcNameID: =BRID_PAPERSIZE_INDEXCARD_DISPLAY
        *PageDimensions: PAIR(3000, 4800)
        *switch: PrintArea
        {
            *case: EdgeNear
            {
                *PrintableArea: PAIR(2976, 4776)
                *PrintableOrigin: PAIR(11, 11)
                *CursorOrigin: PAIR(11, 11)
            }
            *default:
            {
                *PrintableArea: PAIR(2856, 4656)
                *PrintableOrigin: PAIR(70, 70)
                *CursorOrigin: PAIR(70, 70)
