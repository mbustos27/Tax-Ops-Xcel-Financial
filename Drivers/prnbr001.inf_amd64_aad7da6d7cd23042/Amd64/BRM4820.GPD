*GPDSpecVersion: "1.0"
*GPDFileVersion: "0.8"
*Include: "StdNames.gpd"

*Include: "BRCI02B.GPD"
*GPDFileName: "BRM4820.GPD"
*ModelName: "Brother MFC-4820C USB"
*PrintRate: 11
*PrintRatePPM: 11
*PrintRateUnit: PPM
*MasterUnits: PAIR(600, 600)
*PrinterType: SERIAL

*Feature: PaperSize
{
    *rcNameID: =PAPER_SIZE_DISPLAY
    *DefaultOption: LETTER
    *Option: LETTER
    {
        *rcNameID: =RCID_DMPAPER_SYSTEM_NAME
        *switch: PrintArea
        {
            *case: EdgeNear
            {
                *PrintableArea: PAIR(5080, 6576)
                *PrintableOrigin: PAIR(11, 11)
                *CursorOrigin: PAIR(11, 11)
            }
            *default:
            {
                *PrintableArea: PAIR(4960, 6456)
                *PrintableOrigin: PAIR(70, 70)
                *CursorOrigin: PAIR(70, 70)
            }
        }
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.6
            *Cmd: ""
        }
    }
    *Option: LEGAL
    {
        *rcNameID: =RCID_DMPAPER_SYSTEM_NAME
        *switch: PrintArea
        {
            *case: EdgeNear
            {
                *PrintableArea: PAIR(5080, 6576)
                *PrintableOrigin: PAIR(11, 11)
                *CursorOrigin: PAIR(11, 11)
            }
            *default:
            {
                *PrintableArea: PAIR(4960, 8256)
                *PrintableOrigin: PAIR(70, 70)
                *CursorOrigin: PAIR(70, 70)
            }
        }
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.6
            *Cmd: ""
        }
    }
    *Option: A4
    {
        *rcNameID: =RCID_DMPAPER_SYSTEM_NAME
        *switch: PrintArea
        {
            *case: EdgeNear
            {
                *PrintableArea: PAIR(4936, 6992)
                *PrintableOrigin: PAIR(11, 11)
                *CursorOrigin: PAIR(11, 11)
            }
            *default:
            {
                *PrintableArea: PAIR(4816, 6872)
                *PrintableOrigin: PAIR(70, 70)
                *CursorOrigin: PAIR(70, 70)
            }
        }
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.6
            *Cmd: ""
        }
    }
    
    *Option: EXECUTIVE
    {
        *rcNameID: =RCID_DMPAPER_SYSTEM_NAME
        *switch: PrintArea
        {
            *case: EdgeNear
            {
                *PrintableArea: PAIR(4328, 6280)
                *PrintableOrigin: PAIR(11, 11)
                *CursorOrigin: PAIR(11, 11)
            }
            *default:
            {
                *PrintableArea: PAIR(4208, 6160)
                *PrintableOrigin: PAIR(70, 70)
                *CursorOrigin: PAIR(70, 70)
            }
        }
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.6
            *Cmd: ""
        }
    }
    *Option: A5
    {
        *rcNameID: =RCID_DMPAPER_SYSTEM_NAME
        *switch: PrintArea
        {
            *case: EdgeNear
            {
                *PrintableArea: PAIR(3472, 4936)
                *PrintableOrigin: PAIR(11, 11)
                *CursorOrigin: PAIR(11, 11)
            }
            *default:
            {
                *PrintableArea: PAIR(3352, 4816)
                *PrintableOrigin: PAIR(70, 70)
                *CursorOrigin: PAIR(70, 70)
            }
        }
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.6
            *Cmd: ""
        }
    }
    *Option: ENV_10
    {
        *rcNameID: =RCID_DMPAPER_SYSTEM_NAME
        *switch: PrintArea
        {
            *case: EdgeNear
            {
                *PrintableArea: PAIR(2448, 5680)
                *PrintableOrigin: PAIR(11, 11)
                *CursorOrigin: PAIR(11, 11)
            }
            *default:
            {
                *PrintableArea: PAIR(2336, 4896)
                *PrintableOrigin: PAIR(70, 401)
                *CursorOrigin: PAIR(70, 401)
            }
        }
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.6
            *Cmd: ""
        }
    }
    *Option: ENV_DL
    {
        *rcNameID: =RCID_DMPAPER_SYSTEM_NAME
        *switch: PrintArea
        {
            *case: EdgeNear
            {
                *PrintableArea: PAIR(2576, 5176)
                *PrintableOrigin: PAIR(11, 11)
                *CursorOrigin: PAIR(11, 11)
            }
            *default:
            {
                *PrintableArea: PAIR(2456, 4392)
                *PrintableOrigin: PAIR(70, 401)
                *CursorOrigin: PAIR(70, 401)
            }
        }
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.6
            *Cmd: ""
        }
    }
    *Option: ENV_C5
    {
        *rcNameID: =RCID_DMPAPER_SYSTEM_NAME
        *switch: PrintArea
        {
            *case: EdgeNear
            {
                *PrintableArea: PAIR(3800, 5384)
                *PrintableOrigin: PAIR(11, 11)
                *CursorOrigin: PAIR(11, 11)
            }
