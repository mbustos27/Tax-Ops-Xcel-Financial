*Command: CmdStartJob
{
    *Order: JOB_SETUP.1
    *Cmd: "<1B>@"
}
*Command: CmdStartPage
{
	*Order: PAGE_SETUP.1
	*CallbackID: 3
	*Params: LIST(PageNumber)
}
*Command: CmdEndDoc
{
    *Order: DOC_FINISH.1
    *Cmd: "<1A>"
}
*Command: CmdCR { *Cmd : "" }
*Command: CmdLF { *Cmd : "" }
*Command: CmdFF { *Cmd : "" }
