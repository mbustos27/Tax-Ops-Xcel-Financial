*ImageableArea A5:     "5.8201 5.76 412.86 589.44 "
*ImageableArea B5:     "5.76 5.8201 508.8 721.98 "
*ImageableArea BRPostcard/Card: "5.76 5.8201 278.4 412.86 "
*ImageableArea Letter: "5.76 5.8201 604.8 785.34 "
*ImageableArea Legal:  "5.76 5.8201 604.8 1002.3 "
*ImageableArea Env10/Com-10: "0.12 0.0 285.72 660.48 "
*ImageableArea EnvMonarch/Monarch: "0.0 0.12 253.44 528.6 "
*ImageableArea EnvC5/C5: "0.1201 0.0 449.88 629.76 "
*ImageableArea EnvDL/DL: "0.12 0.0 300.6 599.04 "
*ImageableArea Executive: "5.4 5.28 516.12 742.56 "

*?ImageableArea: "
 save
   /cvp { (                ) cvs print ( ) print } bind def
   /upperright {10000 mul floor 10000 div} bind def
   /lowerleft {10000 mul ceiling 10000 div} bind def
   newpath clippath pathbbox
   4 -2 roll exch 2 {lowerleft cvp} repeat
   exch 2 {upperright cvp} repeat
   (\n) print flush
 restore
"
*End

