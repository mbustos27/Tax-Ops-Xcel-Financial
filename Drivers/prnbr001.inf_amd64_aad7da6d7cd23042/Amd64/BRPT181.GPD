*Feature: PaperSize
{
    *rcNameID: =PAPER_SIZE_DISPLAY
    *DefaultOption: 18-Tape
    *Option: 6-Tape
    {
        *Name: "6mm"
        *PageDimensions: PAIR(42, 7086)
        *PrintableArea: PAIR(32, 7058)
        *PrintableOrigin: PAIR(5, 14)
    }
    *Option: 9-Tape
    {
        *Name: "9mm"
        *PageDimensions: PAIR(64, 7086)
        *PrintableArea: PAIR(50, 7058)
        *PrintableOrigin: PAIR(7, 14)
    }
    *Option: 12-Tape
    {
        *Name: "12mm"
        *PageDimensions: PAIR(84, 7086)
        *PrintableArea: PAIR(70, 7058)
        *PrintableOrigin: PAIR(7, 14)
    }
    *Option: 18-Tape
    {
        *Name: "18mm"
        *PageDimensions: PAIR(128, 7086)
        *PrintableArea: PAIR(112, 7058)
        *PrintableOrigin: PAIR(8, 14)
    }
    *Option: Floppy
    {
        *rcNameID: 550		*% "3.5" floppy disk (18mm)"  Use 18-Tape
        *PageDimensions: PAIR(128, 496)
        *PrintableArea: PAIR(112, 468)
        *PrintableOrigin: PAIR(8, 14)
    }
    *Option: CD-R
    {
        *rcNameID: 501		*% "CD-R case - Spine (6mm)"    Use 6-Tape
        *PageDimensions: PAIR(42, 836)
        *PrintableArea: PAIR(32, 808)
        *PrintableOrigin: PAIR(5, 14)
    }
    *Option: MO1
    {
        *rcNameID: 551		*% "MO - Face (18mm)"    Use18-Tape
        *PageDimensions: PAIR(128, 496)
        *PrintableArea: PAIR(112, 468)
        *PrintableOrigin: PAIR(8, 14)
    }
    *Option: MO2
    {
        *rcNameID: 503		*% "MO Case - Spine (6mm)"    Use 6-Tape
        *PageDimensions: PAIR(42, 638)
        *PrintableArea: PAIR(32, 610)
        *PrintableOrigin: PAIR(5, 14)
    }
    *Option: VHS
    {
        *rcNameID: 504		*% "VHS Video Cassette (18mm)"   Use 18-Tape
        *PageDimensions: PAIR(128, 1049)
        *PrintableArea: PAIR(112, 1021)
        *PrintableOrigin: PAIR(8, 14)
    }
    *Option: DV1
    {
        *rcNameID: 505		*% "mini DV Cassette - Spine (9mm)"    Use 9-Tape
        *PageDimensions: PAIR(64, 326)
        *PrintableArea: PAIR(50, 298)
        *PrintableOrigin: PAIR(7, 14)
    }
    *Option: DV2
    {
        *rcNameID: 506		*% "mini DV Cassette - Face (18mm)"   Use Use 18-Tape
        *PageDimensions: PAIR(128, 199)
        *PrintableArea: PAIR(112, 171)
        *PrintableOrigin: PAIR(8, 14)
    }
    *Option: DV3
    {
        *rcNameID: 507		*% "mini DV Cassette Case (12mm)"   Use Use 12-Tape
        *PageDimensions: PAIR(84, 461)
        *PrintableArea: PAIR(70, 433)
        *PrintableOrigin: PAIR(7, 14)
    }
    *Option: 8mm1
    {
        *rcNameID: 508		*% "8mm Video Cassette (9mm)"    Use 9-Tape
        *PageDimensions: PAIR(64, 532)
        *PrintableArea: PAIR(50, 504)
        *PrintableOrigin: PAIR(7, 14)
    }
    *Option: 8mm2
    {
        *rcNameID: 509		*% "8mm Video Cassette Case (12mm)" Use 12-Tape
        *PageDimensions: PAIR(84, 659)
        *PrintableArea: PAIR(70, 631)
        *PrintableOrigin: PAIR(7, 14)
    }
    *Option: 8mm3
    {
        *rcNameID: 552		*% "8mm Video cassette case (18mm)" Use 18-Tape
        *PageDimensions: PAIR(128, 659)
        *PrintableArea: PAIR(112, 631)
        *PrintableOrigin: PAIR(8, 14)
    }
    *Option: Audio1
    {
        *rcNameID: 511		*% "Audio Cassette - Face (6mm)"    Use 6-Tape
        *PageDimensions: PAIR(42, 624)
        *PrintableArea: PAIR(32, 596)
        *PrintableOrigin: PAIR(5, 14)
    }
    *Option: Audio2
    {
        *rcNameID: 512		*% "Audio Cassette Case (9mm)"    Use 9-Tape
        *PageDimensions: PAIR(64, 709)
        *PrintableArea: PAIR(50, 681)
        *PrintableOrigin: PAIR(7, 14)
    }
    *Option: MD1
    {
        *rcNameID: 553		*% "Mini Disc - Face (18mm)"    Use 18-Tape
        *PageDimensions: PAIR(128, 376)
        *PrintableArea: PAIR(112, 348)
        *PrintableOrigin: PAIR(8, 14)
    }
    *Option: MD2
    {
        *rcNameID: 514		*% "Mini Disc Case - Spine (6mm)"    Use 6-Tape
        *PageDimensions: PAIR(42, 532)
        *PrintableArea: PAIR(32, 504)
        *PrintableOrigin: PAIR(5, 14)
    }
    *Option: MD3
    {
        *rcNameID: 554		*% "Mini Disc case - Face (18mm)"    Use 18-Tape
        *PageDimensions: PAIR(128, 503)
        *PrintableArea: PAIR(112, 475)
        *PrintableOrigin: PAIR(8, 14)
    }
    *Option: DAT
    {
        *rcNameID: 516		*% "DAT Cassette - Spine (6mm)"    Use 6-Tape
        *PageDimensions: PAIR(42, 376)
        *PrintableArea: PAIR(32, 348)
        *PrintableOrigin: PAIR(5, 14)
    }
    *Option: ORG1
    {
        *rcNameID: 555		*% "Organizer - Large (18mm)"    Use 18-Tape
        *PageDimensions: PAIR(128, 581)
        *PrintableArea: PAIR(112, 553)
        *PrintableOrigin: PAIR(8, 14)
    }
    *Option: ORG2
    {
        *rcNameID: 556		*% "Organizer - Small (18mm)"    Use 18-Tape
        *PageDimensions: PAIR(128, 461)
        *PrintableArea: PAIR(112, 433)
        *PrintableOrigin: PAIR(8, 14)
    }
    *Option: CUSTOMSIZE
    {
        *rcNameID: =USER_DEFINED_SIZE_DISPLAY
        *MinSize: PAIR(42, 29)
        *MaxSize: PAIR(128, 7086)
	*MaxPrintableWidth: 112
	*CustPrintableOriginX:  %d{max(5, (PhysPaperWidth-112)/2)}
	*CustPrintableOriginY:  %d{14}
	*CustPrintableSizeX:   %d{PhysPaperWidth-max(5, (PhysPaperWidth-112)/2)*2}
	*CustPrintableSizeY:  %d{PhysPaperLength-58}
	*CustCursorOriginX:  %d{max(5, (PhysPaperWidth-112)/2)}
	*CustCursorOriginY:   %d{14}
	*CenterPrintable?: FALSE
    }
}
