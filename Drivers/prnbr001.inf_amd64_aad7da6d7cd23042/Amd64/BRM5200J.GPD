    *Option: CUSTOMSIZE
    {
        *rcNameID: =RCID_DMPAPER_SYSTEM_NAME
        *MinSize: PAIR(2100,2400)
        *MaxSize: PAIR(5100,8400)
        *switch: PrintArea
        {
            *case: EdgeNear
            {
                *TopMargin: 70
                *BottomMargin: 70
            }
            *default:
            {
                *TopMargin: 70
                *BottomMargin: 283
            }
        }
        *MaxPrintableWidth: 4816
        *MinLeftMargin: 70
        *CenterPrintable?: TRUE
    }
}

*Feature: MediaType
{
    *rcNameID: =MEDIA_TYPE_DISPLAY
	*UpdateQualityMacro?: TRUE
    *DefaultOption: Plain
    *Option: Plain
    {
        *rcNameID: =BRID_MEDIATYPE_PLAIN_DISPLAY
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *CallbackID: 20
        }
    }
    *Option: Inkjet
    {
        *rcNameID: =BRID_MEDIATYPE_INKJET_DISPLAY
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *CallbackID: 27
        }
		*Constraints: LIST( Resolution.Option1, Resolution.Option2 )
    }
    *Option: Glossy
    {
        *rcNameID: =BRID_MEDIATYPE_GLOSSY4_DISPLAY
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *CallbackID: 28
        }
		*Constraints: LIST( Resolution.Option1, Resolution.Option2 )
    }
    *Option: Glossy_tri
    {
        *rcNameID: =BRID_MEDIATYPE_GLOSSY3_DISPLAY
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *CallbackID: 26
        }
		*Constraints: LIST( Resolution.Option1, Resolution.Option2 )
    }
    *Option: Transparency
    {
        *rcNameID: =BRID_MEDIATYPE_OHP_DISPLAY
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *CallbackID: 24
        }
		*Constraints: LIST( Resolution.Option1, Resolution.Option2 )
    }
}

*Feature: PrintArea
{
    *rcNameID: =BRID_EDGEPRINT_NEAR_DISPLAY
    *DefaultOption: EdgeNear
    *Option: EdgeNormal
    {
        *rcNameID: =OFF_DISPLAY
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.8
            *CallbackID: 80
        }
    }
    *Option: EdgeNear
    {
        *rcNameID: =ON_DISPLAY
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.8
            *CallbackID: 81
        }
		*Constraints: LIST( PaperSize.JENV_YOU4 )
    }
}
