        {
            *Order: DOC_SETUP.6
            *Cmd: ""
        }
    }
    
    *Option: EXECUTIVE
    {
        *rcNameID: =RCID_DMPAPER_SYSTEM_NAME
        *switch: PrintArea
        {
            *case: EdgeNear
            {
                *PrintableArea: PAIR(4208, 6160)
