    {
        *rcNameID: =BRID_PAPERSIZE_JPHOTO1L_DISPLAY
        *PageDimensions: PAIR(2102, 3000)
        *switch: PrintArea
        {
            *case: EdgeNear
            {
                *PrintableArea: PAIR(1960, 2856)
