*GPDSpecVersion: "1.0"
*GPDFileVersion: "0.8"
*Include: "StdNames.gpd"

*Include: "BRCI02A.GPD"
*GPDFileName: "BRM5200J.GPD"
*ModelName: "Brother MFC-5200J USB"
*PrintRate: 16
*PrintRatePPM: 16
*PrintRateUnit: PPM
*MasterUnits: PAIR(600, 600)
*PrinterType: SERIAL

*Feature: PaperSize
{
    *rcNameID: =PAPER_SIZE_DISPLAY
    *DefaultOption: LETTER
    *Option: LETTER
    {
        *rcNameID: =RCID_DMPAPER_SYSTEM_NAME
        *switch: PrintArea
        {
            *case: EdgeNear
            {
                *PrintableArea: PAIR(4816, 6456)
                *PrintableOrigin: PAIR(140, 70)
            }
            *default:
            {
                *PrintableArea: PAIR(4816, 6248)
                *PrintableOrigin: PAIR(140, 70)
            }
        }
        *CursorOrigin: PAIR(140, 70)
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.6
            *Cmd: ""
        }
    }
    *Option: LEGAL
    {
        *rcNameID: =RCID_DMPAPER_SYSTEM_NAME
        *switch: PrintArea
        {
            *case: EdgeNear
            {
                *PrintableArea: PAIR(4816, 8256)
                *PrintableOrigin: PAIR(140, 70)
            }
            *default:
            {
