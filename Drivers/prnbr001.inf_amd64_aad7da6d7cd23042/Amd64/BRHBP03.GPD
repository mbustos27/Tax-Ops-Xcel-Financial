*MasterUnits: PAIR(1200, 1200)
*ResourceDLL: "brmzui03.dll"
*PrinterType: PAGE
*Include: "StdNames.gpd"
*rcInstalledOptionNameID: =ON_DISPLAY
*rcNotInstalledOptionNameID: =OFF_DISPLAY

*Feature: Orientation
{
    *rcNameID: =ORIENTATION_DISPLAY
    *DefaultOption: PORTRAIT
    *Option: PORTRAIT
    {
        *rcNameID: =PORTRAIT_DISPLAY
        *NoPageEject?: TRUE
    }
    *Option: LANDSCAPE_CC270
    {
        *rcNameID: =LANDSCAPE_DISPLAY
        *NoPageEject?: TRUE
    }
}

*Feature: TonerSave
{
    *rcNameID: 340
    *DefaultOption: OemDocProp
    *Option: OemDocProp
    {
        *rcNameID: =OFF_DISPLAY
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.8
            *CallbackID: 13
        }
    }
}

*Feature: PaperSize
{
    *rcNameID: =PAPER_SIZE_DISPLAY
    *DefaultOption: LETTER
    *Option: LETTER
    {
        *rcNameID: =RCID_DMPAPER_SYSTEM_NAME
        *switch: PrintArea
        {
            *case: Normal
            {
                *switch: Orientation
                {
                    *case: PORTRAIT
                    {
                        *PrintableArea: PAIR(9600, 12800)
                        *PrintableOrigin: PAIR(300, 200)
                        *CursorOrigin: PAIR(300, 200)
                    }
                    *case: LANDSCAPE_CC270
                    {
                        *PrintableArea: PAIR(9800, 12720)
                        *PrintableOrigin: PAIR(200, 240)
                        *CursorOrigin: PAIR(200, 240)
                    }
                }
            }
            *case: Wide
            {
                *PrintableArea: PAIR(9800, 12800)
                *PrintableOrigin: PAIR(200, 200)
                *CursorOrigin: PAIR(200, 200)
            }
        }
