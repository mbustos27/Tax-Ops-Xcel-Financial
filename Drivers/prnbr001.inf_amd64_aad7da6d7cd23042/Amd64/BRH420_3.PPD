*BRAIRegi True/On: "
userdict
/setcolorspace
{
    dup type (arraytype) eq {
        dup 0 get /Separation eq {
            dup 1 get (All) eq {
                dup length array copy dup 1 (AC) put setcolorspace
            }{
                //setcolorspace
            }ifelse
        }{
            //setcolorspace
        }ifelse
    }{
        //setcolorspace
    }ifelse
} bind
put
"
