*IgnoreBlock:
{
	*Option: CUSTOMSIZE
	{
		*rcNameID: =RCID_DMPAPER_SYSTEM_NAME
		*MinSize: PAIR(2124,3000)
		*MaxSize: PAIR(5100,8400)
		*TopMargin: 70
		*BottomMargin: 261
		*MaxPrintableWidth: 4800
		*MinLeftMargin: 80
		*CenterPrintable?: TRUE
	}
}
}

