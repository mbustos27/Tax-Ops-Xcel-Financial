*GPDSpecVersion: "1.0"
*GPDFileVersion: "0.8"
*Include: "StdNames.gpd"

*Include: "brclr01.gpd"
*GPDFileName: "BRM3200C.GPD"
*ModelName: "Brother MFC-3200C USB"
*PrintRate: 8
*PrintRatePPM: 8
*PrintRateUnit: PPM
*MasterUnits: PAIR(600, 600)
*PrinterType: SERIAL

*switch: MediaType
{
	*case: Plain
	{
		*switch: DraftType
		{
			*case: FastDraft
			{
				*DraftQualitySettings: LIST(Resolution.Option1)
				*BetterQualitySettings: LIST()
				*BestQualitySettings: LIST()
				*DefaultQuality: DRAFTQUALITY
			}
			*default: 
			{
				*DraftQualitySettings: LIST(Resolution.Option1, DraftType.Draft)
				*BetterQualitySettings: LIST(Resolution.Option2, DraftType.Draft)
				*BestQualitySettings: LIST(Resolution.Option3, DraftType.Draft)
				*DefaultQuality: BETTERQUALITY
			}
		}
	}
	*case: Inkjet
	{
		*DraftQualitySettings: LIST()
		*BetterQualitySettings: LIST(Resolution.Option3, DraftType.Draft)
		*BestQualitySettings: LIST(Resolution.Option4, DraftType.Draft)
		*DefaultQuality: BETTERQUALITY
	}
	*case: Glossy  
	{
		*DraftQualitySettings: LIST()
		*BetterQualitySettings: LIST(Resolution.Option3, DraftType.Draft)
		*BestQualitySettings: LIST(Resolution.Option4, DraftType.Draft)
		*DefaultQuality: BESTQUALITY
	}
	*case: Glossy_tri  
	{
		*DraftQualitySettings: LIST()
		*BetterQualitySettings: LIST(Resolution.Option3, DraftType.Draft)
		*BestQualitySettings: LIST(Resolution.Option4, DraftType.Draft)
		*DefaultQuality: BESTQUALITY
	}
	*default:   
	{
		*DraftQualitySettings: LIST()
		*BetterQualitySettings: LIST(Resolution.Option3, DraftType.Draft)
		*BestQualitySettings: LIST(Resolution.Option4, DraftType.Draft)
		*DefaultQuality: BETTERQUALITY
	}
}


*Feature: Orientation
{
    *rcNameID: =ORIENTATION_DISPLAY
    *DefaultOption: PORTRAIT
    *Option: PORTRAIT
    {
        *rcNameID: =PORTRAIT_DISPLAY
    }
    *Option: LANDSCAPE_CC270
    {
        *rcNameID: =LANDSCAPE_DISPLAY
    }
}
*Feature: Resolution
{
    *rcNameID: =RESOLUTION_DISPLAY
    *DefaultOption: Option2
    *Option: Option1
    {
        *rcNameID: =BRID_RESOLUTION_OPTION1_DISPLAY
		*OptionID: -1
        *DPI: PAIR(150, 150)
        *TextDPI: PAIR(150, 150)
        *PinsPerLogPass: 32
        *PinsPerPhysPass: 1
        *SpotDiameter: 100
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *Cmd: ""
        }
    }
    *Option: Option2
    {
        *rcNameID: =BRID_RESOLUTION_OPTION2_DISPLAY
		*OptionID: -2
        *DPI: PAIR(300, 300)
        *TextDPI: PAIR(300, 300)
        *PinsPerLogPass: 32
        *PinsPerPhysPass: 1
        *SpotDiameter: 100
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *Cmd: ""
        }
    }
    *Option: Option3
    {
        *rcNameID: =BRID_RESOLUTION_OPTION3_DISPLAY
		*OptionID: -3
        *DPI: PAIR(600, 600)
        *TextDPI: PAIR(600, 600)
        *PinsPerLogPass: 32
        *PinsPerPhysPass: 1
        *SpotDiameter: 100
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *Cmd: ""
        }
    }
    *Option: Option4
    {
        *rcNameID: =BRID_RESOLUTION_OPTION4_DISPLAY
		*OptionID: -4
        *DPI: PAIR(600, 600)
        *TextDPI: PAIR(600, 600)
        *PinsPerLogPass: 32
        *PinsPerPhysPass: 1
        *SpotDiameter: 100
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *Cmd: ""
        }
    }
}
