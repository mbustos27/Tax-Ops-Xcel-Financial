# TaxOps environment — copy to `.env` beside `taxops/` or `taxops/.env` (ignored by git).
#
# Loading order:
# 1. OS / NSSM / shell exports (always respected — `.env` never overrides these).
# 2. Repo-root `.env` (fills missing keys).
# 3. ``taxops/.env`` overlays #2 — use this file for deployment-specific URLs (overrides localhost in root template).
#
# If `OLLAMA_BASE_URL` resolves to localhost but your GPU host is elsewhere, check NSSM/AppEnvironmentExtra
# for a stray `OLLAMA_BASE_URL`; remove or correct it — it overrides `.env`.
#
# NSSM notes:
# - First AppEnvironmentExtra line must be VAR=value — do NOT prefix the key with ":".
# - Additional lines: nssm set SERVICE AppEnvironmentExtra +VAR=value
# - Prefer a venv python + `AppDirectory` = folder containing app.py — see scripts/nssm-taxops-snippet.ps1
#
# ── Ollama (tags must match `ollama list` on the inference host)
OLLAMA_BASE_URL=http://192.168.1.141:11434

# Pulled-catalog examples (rename if yours differ):
#   qwen2.5:7b-instruct-q4_K_M  — faster /ai/chat tool-router JSON
#   llama3.1:8b-instruct-q4_K_M — stronger chat answers
#   llama3.2:latest             — lightweight default + text-layer PDF extraction
#   llama3.2-vision:latest       — scanned PDF / image extraction

OLLAMA_MODEL=llama3.2:latest
OLLAMA_ROUTER_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_CHAT_MODEL=llama3.1:8b-instruct-q4_K_M
# Tool-router (/api/generate JSON) wait cap. LAN/remote Ollama often needs 90–180s on first load or busy GPU.
OLLAMA_CHAT_ROUTER_TIMEOUT=120
OLLAMA_CHAT_ANSWER_TIMEOUT=120

# When the tool-router cannot reach Ollama (timeouts, connection errors), continue with aggregates-first
# routing instead of HTTP 503. Default on; set false to preserve strict 503.
# NSSM overlay example: nssm set TaxOpsService AppEnvironmentExtra +CHAT_ROUTER_TRANSPORT_FAIL_AGGREGATES=true
# CHAT_ROUTER_TRANSPORT_FAIL_AGGREGATES=true
#
# If router transport failed above, skip the answer LLM on null-tool replies and paste compact KPI markdown.
# NSSM overlay: nssm set TaxOpsService AppEnvironmentExtra +CHAT_ANSWER_ON_ROUTER_TIMEOUT_SKIP_LLM=true
# CHAT_ANSWER_ON_ROUTER_TIMEOUT_SKIP_LLM=true

# Optional: planner confidence abstain (/ai/chat) — with mode need_rows, below this ⇒ aggregates path (no row tool).
# CHAT_ROUTER_CONFIDENCE_MIN=0.55

OLLAMA_EXTRACT_MODEL_TEXT=llama3.2:latest
OLLAMA_EXTRACT_MODEL_VISION=llama3.2-vision:latest
OLLAMA_EXTRACT_TIMEOUT_TEXT=90
OLLAMA_EXTRACT_TIMEOUT_VISION=180

# Optional: SQLite chat answer cache (/ai/chat) — see export_ai_chat_common_qa.py
# AI_CHAT_DISK_CACHE_ENABLE=true
# AI_CHAT_DISK_CACHE_HOURS=168

# Optional: chat scope-training JSONL
# CHAT_TRAINING_LOG_ENABLE=true
# CHAT_TRAINING_LOG_CACHE_HITS=false
# CHAT_TRAINING_LOG_PATH=C:/path/to/taxops/data/ai_chat_staff_queries.jsonl

# Auth — NEVER commit live secrets (`.env`/NSSM/GitHub-safe copies only — PROD-5 GitHub #93).
#
# Startup validates strict credentials when ``TAXOPS_ENV`` names a deployed profile (`production`, `staging`, …).
# Not strict for: `demo` / `dev` / `development` / `local` / `test`, or ``FLASK_DEBUG=1``.
# Explicitly set stable values (NSSM/AppEnvironmentExtra or ``taxops/.env`` overlays):
#
# Flask session signing (generate: ``python -c "import secrets; print(secrets.token_urlsafe(32))"``)
# TAXOPS_SECRET=PASTE_STABLE_RANDOM_STRING_HERE_MIN_16
TAXOPS_USER=info
TAXOPS_PASS=changeme

# Multi-user auth (takes precedence over TAXOPS_USER/TAXOPS_PASS above).
# Format: username:password:role;username:password:role
# Roles: staff | preparer | admin
# TAXOPS_USERS=info:changeme:admin;maria:pass1:preparer;front:pass2:staff

# Dashboard saved filters (GitHub #85): comma-separated usernames who may publish shared presets for all staff.
# If unset, only the primary ``TAXOPS_USER`` login may publish shared filters.
# TAXOPS_SHARED_FILTER_ADMINS=alice,bob

# Season rollover (GitHub Epic #88 / ROLLOVER-1): comma-separated login usernames allowed to open Tools → Season rollover
# and call preview/run/export. If unset, only ``TAXOPS_USER`` may run rollover.
# TAXOPS_ROLLOVER_ADMINS=alice,carla

# Multi-year client comparison (GitHub #124–#129) — YoY cell highlights on /clients/<id>
# TAXOPS_MULTIYEAR_AGI_PCT=10
# TAXOPS_MULTIYEAR_REFUND_ABS=500
# TAXOPS_MULTIYEAR_BALANCE_ABS=500

# Bypass strict checks ONLY for deliberate break-glass / broken templates:
# TAXOPS_SKIP_ENV_VALIDATION=1
# DOC-6 — optional Drake Documents mirrored folder layout (per-document sync; groundwork only).
# Uses ``DRAKE_DOCUMENTS_BASE`` + ``DRAKE_FOLDER_STRUCTURE_ENABLED``.
# Separate from ``DRAKE_DOCUMENTS_PATH``, which backs bulk staging + manifest (`drake_documents_sync`).
# DRAKE_DOCUMENTS_BASE=C:\Drake\Documents
# DRAKE_FOLDER_STRUCTURE_ENABLED=false
#
# Bulk copy one return's documents (+ manifest JSON) — existing route:
# DRAKE_DOCUMENTS_PATH=G:/Drake/DT/Data

# Email watcher — leave IMAP_HOST empty to disable the poller locally; enabling without IMAP_PASS fails strict prod checks (PROD-5).
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=office@example.com
IMAP_PASS=
IMAP_POLL_INTERVAL=120
IMAP_FOLDER=INBOX
USE_GMAIL_CATEGORIES=true
# IMAP_MARK_AS_READ=false
IMAP_DRY_RUN=false
# Max consecutive retry attempts before an email is force-skipped (marked as read).
IMAP_MAX_RETRIES=3
# When true: processed emails stay unread in Gmail so staff can review them.
# Uses email_processing_log for restart-safe dedup instead of IMAP \\Seen.
# Auto-skip folders (promotions) are still marked read — those are pure noise.
IMAP_PRESERVE_UNREAD=false

MAIL_WATCHER_LLM_TIMEOUT=45
MAIL_WATCHER_CLIENT_MATCH_MIN_SCORE=82

# Enable vision extraction for image files (PNG, JPEG)
# Disabled by default — images are saved to returns and tagged manually by staff
# Enable only if Ollama has sufficient resources for concurrent vision requests
EXTRACTOR_VISION_ENABLED=false

# Comma-separated client business domains — bypasses the ML classifier and routes
# directly to LLM evaluation.  Add confirmed client domains here; after the first
# successful attachment save the domain is auto-boosted into the cache so subsequent
# emails hit the cache layer and skip both ML and LLM entirely.
# Example: IMAP_CLIENT_HINT_DOMAINS=olavictory.org,coronabrosinstall.com,orealtyllc.com
IMAP_CLIENT_HINT_DOMAINS=

# Asymmetric classifier confidence thresholds.
# Promotional requires higher confidence to avoid silently dropping client emails.
# Below the relevant threshold the ML result is discarded and LLM is used instead.
# CLASSIFIER_PROMOTIONAL_THRESHOLD=0.80
# CLASSIFIER_CLIENT_THRESHOLD=0.65

# Dev only (NSSM/production: keep FLASK_DEBUG off)
# FLASK_DEBUG=1
#
# WSGI / Waitress (GitHub #136–138): python app.py uses Waitress when FLASK_DEBUG is not 1.
# NSSM/Task Scheduler deployments should leave FLASK_DEBUG unset or 0.
# WAITRESS_THREADS=8
# WAITRESS_HOST=0.0.0.0
# WAITRESS_PORT=5000


# PROD-2 — structured JSON lines to a rotating file; level affects app + werkzeug loggers (GitHub #90).
# Recommended on NSSM hosts: point at a writable path and set TAXOPS_LOG_CONSOLE=false to avoid doubling
# with AppStdout/AppStderr; keep NSSM captures for abrupt crashes outside Python logging.
#
# TAXOPS_LOG_LEVEL=INFO
# TAXOPS_LOG_JSON_PATH=C:/TaxOps/logs/taxops-app.jsonl
# TAXOPS_LOG_JSON_MAX_MB=50
# TAXOPS_LOG_JSON_BACKUPS=10
# TAXOPS_LOG_CONSOLE=false

# Optional: overrides `/health` JSON `version` and is the default static-asset ``?v=`` token
# when ``TAXOPS_APP_VERSION`` is unset (same as release label for staff-facing "build id").
# Bump when you deploy static (JS/CSS) changes so browsers pull fresh files (GitHub CACHE #141–#144).
# TAXOPS_VERSION=1.4.0
#
# Optional: bump **only** this when you ship static bundle changes without altering TAXOPS_VERSION
# (forces new ``?v=`` on app.js / app.css / tw.min.css query strings).
# TAXOPS_APP_VERSION=20260207a

# PROD-4 — nightly SQLite backup (GitHub #92). Prefer a path outside repo on production hosts.
# Windows Task Scheduler: see scripts/register-nightly-backup-task.ps1
#
# Optional JSON POST on failure — Slack Incoming Webhooks work with default payload shape.
#
# TAXOPS_BACKUP_DIR=C:/TaxOps/backups/sqlite
# TAXOPS_BACKUP_RETENTION_DAYS=30
# TAXOPS_BACKUP_ALERT_WEBHOOK=https://hooks.slack.com/services/REPLACE/REPLACE/REPLACE

