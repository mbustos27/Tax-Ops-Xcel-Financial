# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/

# Database files — allowed for now for portability
# *.db

# Sensitive data files — local env (TaxOps reads repo-root `.env` via config.py).
.env
taxops/.secret_key

# Compliance Tracker — dev-only Fernet key fallback (compliance/crypto.py).
# Never commit: this decrypts every stored CDTFA/city-portal password.
# Production must set COMPLIANCE_ENCRYPTION_KEY instead of relying on this file.
taxops/.compliance_key

# Name reconciliation tool — output files contain client names and must not
# be committed.  The verdict cache is also an audit log of every LLM judgment
# and may contain client names.
tools/name_reconciliation/verdict_cache.json
reconcile_output/

taxops/data/incoming/*.csv
taxops/data/backups/
taxops/data/logs/
taxops/data/ai_chat_staff_queries.jsonl
restart_taxops.ps1
# OS
.DS_Store
Thumbs.db

# Pytest log output (see taxops/write_test_log.py)
taxops/test_logs/

# Editor
.vscode/
*.swp
*.swo

# Front-end build (Tailwind — `npm run build:tw` in taxops/ or scripts/build-tailwind.ps1)
taxops/node_modules/
taxops/.tailwind/

# ── Client PII and local-only artifacts (added during email-system stabilization) ──
# Client tax documents (W-2s, receipts, signed forms, email attachments) — never commit.
*.pdf
taxops/documents/
# One-off / scratch database copies used during recovery and migration testing.
taxops/taxops.db.corrupt
taxops/taxops_rebuilt.db
taxops/taxops_recovered.db
taxops/taxops_test.db
taxops/taxops_test_ext.db
# Client-data exports and one-off audit CSVs generated by scripts/.
taxops/data/exports/*.csv
taxops/scripts/*.csv
taxops/scripts/*.log
# Spouse/export audit CSVs from verify and orphan review scripts.
taxops/reports/
# Vector store / RAG embeddings cache.
chroma_db/
# Logs and nightly backup drops.
logs/
backups/
taxops/backups/
# LedgerBridge is a separate sub-app not yet integrated into this repo's history.
ledgerbridge/

# Client audit tool — findings workbooks and audit DBs contain PII; never commit.
audit/output/
audit/snapshots/
audit/audit_*.sqlite
audit/**/*.xlsx
!audit/fixtures/**
